/* ==========================================================================
   Interactive Niri Firefox-Style Tabs (`group/niritabs`)
   ========================================================================== */
#niritabs {
    background-color: transparent;
    padding: 1px 10px;
}

/* Pagination arrows: minimal, icon only, no button box */
#custom-page-prev,
#custom-page-next {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0 5px;
    margin: 0;
    font-size: 9pt;
    font-weight: normal;
    color: rgba(222, 222, 222, 0.35);
    transition: all 150ms cubic-bezier(0.215, 0.61, 0.355, 1);
}

#custom-page-prev:hover,
#custom-page-next:hover {
    color: #ffffff;
}

/* Tab slots (group/tab-N): outer group container */
#tab-0, #tab-1, #tab-2, #tab-3, #tab-4, #tab-5 {
    background-color: transparent;
    margin: 1px 2px;
}

/* Tab body (icon + short title) - left half of the pill */
#custom-tab-0, #custom-tab-1, #custom-tab-2,
#custom-tab-3, #custom-tab-4, #custom-tab-5 {
    background-color: rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    border-left: 1px solid rgba(255, 255, 255, 0.07);
    border-right: none;
    border-radius: 5px 0 0 5px;
    padding: 1px 2px 1px 7px;
    font-size: 8pt;
    font-weight: normal;
    color: rgba(222, 222, 222, 0.65);
    transition: all 150ms cubic-bezier(0.215, 0.61, 0.355, 1);
}

/* Tab close button (minimal ×) - right half of the pill, centered with proper margins */
#custom-tab-close-0, #custom-tab-close-1, #custom-tab-close-2,
#custom-tab-close-3, #custom-tab-close-4, #custom-tab-close-5 {
    background-color: rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    border-left: none;
    border-radius: 0 5px 5px 0;
    padding: 0 8px 0 6px;
    font-size: 5.5pt;
    font-weight: normal;
    color: rgba(222, 222, 222, 0.35);
    transition: all 150ms cubic-bezier(0.215, 0.61, 0.355, 1);
}

/* Tab body hover */
#custom-tab-0:hover, #custom-tab-1:hover, #custom-tab-2:hover,
#custom-tab-3:hover, #custom-tab-4:hover, #custom-tab-5:hover {
    background-color: rgba(255, 255, 255, 0.11);
    color: #ffffff;
}

/* Close button hover (subtle red highlight) */
#custom-tab-close-0:hover, #custom-tab-close-1:hover, #custom-tab-close-2:hover,
#custom-tab-close-3:hover, #custom-tab-close-4:hover, #custom-tab-close-5:hover {
    background-color: rgba(224, 108, 117, 0.22);
    color: #e06c75;
}

/* Active tab state: both halves illuminate together as one seamless pill (zero font-weight jitter) */
#custom-tab-0.active, #custom-tab-1.active, #custom-tab-2.active,
#custom-tab-3.active, #custom-tab-4.active, #custom-tab-5.active {
    background-color: rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    border-left: 1px solid rgba(255, 255, 255, 0.28);
    color: #ffffff;
    font-weight: normal;
    font-size: 8pt;
}

#custom-tab-close-0.active, #custom-tab-close-1.active, #custom-tab-close-2.active,
#custom-tab-close-3.active, #custom-tab-close-4.active, #custom-tab-close-5.active {
    background-color: rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    border-right: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.55);
    font-weight: normal;
    font-size: 5.5pt;
}

#custom-tab-close-0.active:hover, #custom-tab-close-1.active:hover, #custom-tab-close-2.active:hover,
#custom-tab-close-3.active:hover, #custom-tab-close-4.active:hover, #custom-tab-close-5.active:hover {
    background-color: rgba(224, 108, 117, 0.25);
    color: #e06c75;
}

/* ==========================================================================
   Alternative: Single-Module Taskbar (`custom/niritaskbar`)
   ========================================================================== */
#custom-niritaskbar {
    background-color: transparent;
    font-size: 8pt;
    font-weight: normal;
    padding: 1px 10px;
}
