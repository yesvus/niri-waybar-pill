{
    // Option 1: Workspace-Filtered Compact Taskbar (Each window as a distinct pill)
    "custom/niritaskbar": {
        "exec": "~/.config/waybar/niri-taskbar.py",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "niri msg action toggle-overview",
        "on-click-right": "niri msg action close-window",
        "on-scroll-up": "niri msg action focus-column-left",
        "on-scroll-down": "niri msg action focus-column-right"
    },

    // Option 2: Floating Window Pill (Title + Window Count Radar + Maximize/Close Controls)
    "group/windowpill": {
        "orientation": "horizontal",
        "modules": [
            "niri/window",
            "custom/wincount",
            "custom/win-maximize",
            "custom/win-close"
        ]
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 35,
        "tooltip": false
    },
    "custom/wincount": {
        "exec": "~/.config/waybar/niri-wincount.py",
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "custom/win-maximize": {
        "format": "󰘖",
        "tooltip": false,
        "on-click": "niri msg action maximize-column"
    },
    "custom/win-close": {
        "format": "",
        "tooltip": false,
        "on-click": "niri msg action close-window"
    }
}
