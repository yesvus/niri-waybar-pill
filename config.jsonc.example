{
    // Native niri workspaces indicator with mouse scroll support
    "niri/workspaces": {
        "format": "{index}",
        "tooltip": false,
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    // Background daemon that keeps tab states fresh in /dev/shm/niri-tabs/
    "custom/niri-daemon": {
        "exec": "~/.config/waybar/niri-tab-daemon.py",
        "format": "",
        "tooltip": false
    },

    // Interactive Firefox-style Niri workspace tabs
    // (Seamless pills with integrated centered close buttons, minimal ‹ › pagination)
    "group/niritabs": {
        "orientation": "horizontal",
        "modules": [
            "custom/page-prev",
            "group/tab-0",
            "group/tab-1",
            "group/tab-2",
            "group/tab-3",
            "group/tab-4",
            "group/tab-5",
            "custom/page-next"
        ]
    },
    "custom/page-prev": {
        "format": "‹",
        "tooltip": "Scroll left / previous window",
        "on-click": "niri msg action focus-column-left"
    },
    "custom/page-next": {
        "format": "›",
        "tooltip": "Scroll right / next window",
        "on-click": "niri msg action focus-column-right"
    },

    // Tab Slot 0 (Pill body + integrated centered close button)
    "group/tab-0": {
        "orientation": "horizontal",
        "modules": ["custom/tab-0", "custom/tab-close-0"]
    },
    "custom/tab-0": {
        "exec": "cat /dev/shm/niri-tabs/tab-0.json 2>/dev/null || true",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "hide-empty-text": true,
        "on-click": "~/.config/waybar/niri-tab-action.sh focus 0",
        "on-click-middle": "~/.config/waybar/niri-tab-action.sh close 0",
        "on-click-right": "~/.config/waybar/niri-tab-action.sh close 0",
        "on-scroll-up": "niri msg action focus-column-left",
        "on-scroll-down": "niri msg action focus-column-right"
    },
    "custom/tab-close-0": {
        "exec": "cat /dev/shm/niri-tabs/tab-close-0.json 2>/dev/null || true",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "hide-empty-text": true,
        "on-click": "~/.config/waybar/niri-tab-action.sh close 0"
    },

    // Tab Slot 1
    "group/tab-1": {
        "orientation": "horizontal",
        "modules": ["custom/tab-1", "custom/tab-close-1"]
    },
    "custom/tab-1": {
        "exec": "cat /dev/shm/niri-tabs/tab-1.json 2>/dev/null || true",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "hide-empty-text": true,
        "on-click": "~/.config/waybar/niri-tab-action.sh focus 1",
        "on-click-middle": "~/.config/waybar/niri-tab-action.sh close 1",
        "on-click-right": "~/.config/waybar/niri-tab-action.sh close 1",
        "on-scroll-up": "niri msg action focus-column-left",
        "on-scroll-down": "niri msg action focus-column-right"
    },
    "custom/tab-close-1": {
        "exec": "cat /dev/shm/niri-tabs/tab-close-1.json 2>/dev/null || true",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "hide-empty-text": true,
        "on-click": "~/.config/waybar/niri-tab-action.sh close 1"
    }
    // Repeat group/tab-2 through group/tab-5 accordingly
}
